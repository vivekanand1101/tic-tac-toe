{
  "name": "tic-tac-toe",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "110111",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "MOVE_LIMITER",
      "namespace_id": "110112",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "KEY_LIMITER",
      "namespace_id": "110113",
      "simple": {
        "limit": 24,
        "period": 60
      }
    }
  ],
  "account_id": "21edc7b0d85faf89cdb8681cbc09af54",
  "routes": [],
  "compatibility_flags": [
    "enable_request_signal"
  ],
  "vars": {
    "REQUIRE_LIMITS": "true"
  }
}
