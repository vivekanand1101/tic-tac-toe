{
  "name": "tic-tac-toe",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [{
    "name": "MOVE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 12, "period": 60 }
  }]
}
