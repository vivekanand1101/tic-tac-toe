{
  "name": "tic-tac-toe-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/preview.mjs",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test test/*.test.mjs",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run --outdir .wrangler/deploy"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "wrangler": "^4.157.0"
  }
}
